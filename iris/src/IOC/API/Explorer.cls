Class IOC.API.Explorer Extends %RegisteredObject
{

/// GET /api/ioc/explorer/openapi/:ns/:app — an application's OpenAPI document,
/// generated by the instance itself.
ClassMethod GetSpec(pNamespace As %String, pApp As %String) As %DynamicAbstractObject
{
    ; the namespace may arrive still URL-encoded ("%25SYS" for "%SYS")
    If pNamespace [ "%25" Set pNamespace = $ZCONVERT(pNamespace, "I", "URL")
    Quit ##class(IOC.Service.Management).CallMgmnt("v1/" _ pNamespace _ "/spec/" _ pApp)
}

/// POST /api/ioc/explorer/send — execute a request against this instance.
ClassMethod Send(pRequest As %String) As %DynamicObject
{
    Set tSpec = {}.%FromJSON(pRequest)
    Set tMethod = tSpec.%Get("method")
    If tMethod = "" Set tMethod = "GET"
    Quit ##class(IOC.Service.Management).Proxy(
        tSpec.%Get("path"),
        tMethod,
        tSpec.%Get("params"),
        tSpec.%Get("headers"),
        tSpec.%Get("body"))
}

}
